<mxfile host="app.diagrams.net"><diagram name="1" id="d1"><mxGraphModel dx="1380" dy="470" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="470" math="0" shadow="0" background="#F1F2EE"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value='&lt;b style="font-size:13px"&gt;課綱上的一行書目&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;書名、作者&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B6673;strokeWidth=1.2;strokeDasharray=1 3;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="122" height="84" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b style="font-size:13px"&gt;驗證&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;NCL 或 LOC，再 Google Books，&lt;br&gt;再三民、TAAZE&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="192" y="70" width="160" height="84" as="geometry"/></mxCell><mxCell id="n4" value="配到的是&lt;br&gt;同一本嗎？" style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rhombus;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;spacing=2;" vertex="1" parent="1"><mxGeometry x="392" y="60" width="150" height="104" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b style="font-size:13px"&gt;查 Alma 館藏&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;有沒有、有幾冊&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="642" y="70" width="128" height="84" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b style="font-size:13px"&gt;算冊數&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;需求減現有，&lt;br&gt;單本上限 5 冊&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="806" y="70" width="138" height="84" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b style="font-size:13px"&gt;採購建議&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;附優先級與理由，&lt;br&gt;點 ▸ 看決策過程&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="138" height="84" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b style="font-size:13px"&gt;購物車&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#DCE4F1"&gt;人決定冊數，&lt;br&gt;匯出 CSV 下單&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#26477C;strokeColor=#26477C;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1182" y="70" width="168" height="84" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="是，同一本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="人來決定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value='&lt;b style="font-size:13px"&gt;審核&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;配錯、查無此書、&lt;br&gt;其他&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;dashed=1;dashPattern=6 4;fillColor=#FBF3DF;strokeColor=#BF8A1C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="392" y="300" width="150" height="84" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b style="font-size:13px"&gt;人決定&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;加入採購建議（可改書名），&lt;br&gt;或都不買&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;dashed=1;dashPattern=6 4;fillColor=#FBF3DF;strokeColor=#BF8A1C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="582" y="300" width="170" height="84" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b style="font-size:13px"&gt;套用&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5B6673"&gt;重查館藏、&lt;br&gt;重算採購建議&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=12;fontColor=#1A2430;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A2430;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="792" y="300" width="150" height="84" as="geometry"/></mxCell><mxCell id="e18" value="不是，配錯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#BF8A1C;" edge="1" parent="1" source="n4" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="都查不到（查無此書）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;exitX=0.5;exitY=1;entryX=0;entryY=0.5;strokeColor=#BF8A1C;dashed=1;" edge="1" parent="1" source="n3" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;strokeColor=#BF8A1C;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;strokeColor=#BF8A1C;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=1.5;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;labelBackgroundColor=#F1F2EE;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n17" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="決定存在資料庫裡，重跑 pipeline 不會被洗掉；書的識別鍵改變時，購物車的決定會跟著搬" style="text;html=1;fontFamily=Microsoft JhengHei;fontSize=11;fontColor=#5B6673;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="410" width="640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>